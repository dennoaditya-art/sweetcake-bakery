# SweetCake Configuration
# Copy this file to .env.local and adjust values

# Site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand name (also can be changed in src/lib/config.js)
NEXT_PUBLIC_BRAND_NAME=SweetCake

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@sweetcake.id
NEXT_PUBLIC_CONTACT_PHONE=0812-3456-7890

# Social Media
NEXT_PUBLIC_INSTAGRAM_HANDLE=@sweetcake_id

# Image optimization (next/image remote domains)
# Add comma-separated list of external image domains
NEXT_PUBLIC_IMAGE_DOMAINS=images.unsplash.com,via.placeholder.com
